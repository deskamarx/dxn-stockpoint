# Caddy obtains and renews the TLS certificate automatically, so the shop is
# HTTPS-only with no certificate scripts and no paid service.

{$DXN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API applies its own CORS and rate limiting; keep the real client IP.
	reverse_proxy api:4173 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format json
	}
}
