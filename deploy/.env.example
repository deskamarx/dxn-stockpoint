# Copy to deploy/.env on the server and fill in real values.
# Never commit deploy/.env.

# Domain pointed at the VM's public IP (Cloudflare DNS, A record, DNS only).
DXN_DOMAIN=shop.example.com

# Owner PIN used by the Android owner app and the web admin screen.
DXN_PIN=986532

# Long random admin key for scripts/CI. Generate with:
#   openssl rand -hex 32
DXN_ADMIN_KEY=replace-with-64-hex-characters

# Extra browser origins allowed to call the API, comma-separated.
# Leave empty when the web app is served by this same deployment.
# Wildcards such as https://*.example.com are supported.
DXN_CORS_ORIGINS=

# Requests per minute per IP (default 300).
DXN_RATE_LIMIT=300

# json (default in production) or text.
DXN_LOG_FORMAT=json

# Image tag used by docker compose.
DXN_TAG=latest
